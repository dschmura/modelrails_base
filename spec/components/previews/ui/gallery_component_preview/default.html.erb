<%# Inline solid-color SVG data-URIs as srcs: real markup + meaningful alts, but %>
<%# no network fetch (external image hosts can hang/flake the headless browser). %>
<%
  forest   = "data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20width='400'%20height='400'%3E%3Crect%20width='400'%20height='400'%20fill='%23166534'/%3E%3C/svg%3E"
  city     = "data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20width='400'%20height='400'%3E%3Crect%20width='400'%20height='400'%20fill='%23475569'/%3E%3C/svg%3E"
  mountain = "data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20width='400'%20height='400'%3E%3Crect%20width='400'%20height='400'%20fill='%230c4a6e'/%3E%3C/svg%3E"
%>
<div data-test="gallery">
  <%= render(UI::GalleryComponent.new(cols: 3)) do |g| %>
    <% g.with_image(src: forest, alt: "Forest canopy") %>
    <% g.with_image(src: city, alt: "City street", caption: "Downtown") %>
    <% g.with_image(src: mountain, alt: "Mountain lake") %>
  <% end %>
</div>
