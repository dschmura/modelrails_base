#!/usr/bin/env ruby
# Usage: bin/comment-block-check <staged paths...>  (run by Lefthook pre-commit)
require "bundler/setup"
require "set"
require_relative "../lib/comment_block_check"
require_relative "../lib/clean_git_env"

# Keeps GIT_INDEX_FILE: `git commit -a` hands the hook a temporary index (#789).
env = CleanGitEnv::HASH.except("GIT_INDEX_FILE")

check = CommentBlockCheck.new
failures = ARGV.flat_map do |path|
  source = IO.popen(env, [ "git", "show", ":#{path}" ], err: File::NULL, &:read)
  next [] unless $?.success?

  diff = IO.popen(env, [ "git", "diff", "--cached", "-U0", "--", path ], &:read)
  check.violations(path: path, source: source, added_lines: CommentBlockCheck.added_lines(diff))
       .map { |block| "  #{path}:#{block.first}-#{block.last} (#{block.size} lines)" }
end

exit if failures.empty?

warn <<~MSG
  Comment blocks longer than 6 lines, touched by this commit:

  #{failures.join("\n")}

  A comment states only what the code cannot, as a gist plus a pointer to the
  PR, issue, or doc that holds the rest. See /docs/developer/conventions (3).
MSG
exit 1
