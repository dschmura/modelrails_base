#!/usr/bin/env ruby
# Usage: bin/test-plan [--base REF] [--github-output] [--run [--dry-run]]
# Prints this branch's change lanes and the specs they select; see /docs/developer/testing.
require "optparse"
require "open3"
require_relative "../lib/change_lanes"
require_relative "../lib/clean_git_env"

options = {}
OptionParser.new do |parser|
  parser.on("--base REF") { |ref| options[:base] = ref }
  parser.on("--github-output") { options[:github_output] = true }
  parser.on("--run") { options[:run] = true }
  parser.on("--dry-run") { options[:dry_run] = true }
end.parse!

def git(*args)
  out, status = Open3.capture2(CleanGitEnv::HASH, "git", *args)
  abort "test-plan: git #{args.join(" ")} failed" unless status.success?
  out
end

def ref?(ref)
  system(CleanGitEnv::HASH, "git", "rev-parse", "--verify", "--quiet", "#{ref}^{commit}", out: File::NULL)
end

root = git("rev-parse", "--show-toplevel").chomp
base = options[:base] || %w[origin/next origin/main].find { |ref| ref?(ref) }
paths = (base ? git("diff", "--name-only", "--no-renames", "#{base}...HEAD") : git("ls-files")).lines(chomp: true)

plan = ChangeLanes.classify(paths)
specs = plan.full ? ChangeLanes.related_specs(paths, root:) : ChangeLanes.specs_for(plan, root:)

puts "lanes: #{plan.full ? "full" : plan.lanes.join(" ")}"

if options[:github_output]
  File.write(ENV.fetch("GITHUB_OUTPUT"), "full=#{plan.full}\nspecs=#{specs.join(" ")}\n", mode: "a")
end

unless options[:run]
  puts specs unless options[:github_output]
  exit
end

if specs.empty?
  puts "test-plan: no specs selected"
  exit
end

if options[:dry_run]
  puts "RAILS_ENV=test bin/rails db:setup", "SKIP_COVERAGE=1 bundle exec rspec #{specs.join(" ")}"
  exit
end

Dir.chdir(root)
system({ "RAILS_ENV" => "test" }, "bin/rails", "db:setup", exception: true)
exec({ "SKIP_COVERAGE" => "1" }, "bundle", "exec", "rspec", *specs)
