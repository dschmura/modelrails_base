#!/usr/bin/env ruby
# frozen_string_literal: true

# bin/fork — turn a fresh template clone into YOUR application.
#
# Fork once, setup often. This script makes the decisions that are migrations
# if changed later: the identity rename, the remote surgery, and the tenancy
# preset. Recurring environment bootstrap belongs to bin/setup — including
# per-clone setup for teammates, which reads the provenance this script writes.
# See /docs/developer/forking; this script executes that guide.
#
# State model: live state is DERIVED from the repository (the rename lives in a
# commit; remotes are per-clone), so re-running repairs rather than corrupts.
# The decisions are RECORDED in .fork.yml, committed so every clone inherits
# them. Derived state gates; recorded state remembers.
#
#   bin/fork                                   # interactive Q&A
#   bin/fork --name my_app --preset none --origin git@github.com:me/my_app.git --yes
#   bin/fork --preset shared                   # on a forked repo: change the preset
#   bin/fork --dry-run                         # print the plan, mutate nothing
#
# Plain Ruby, stdlib only (template doctrine: no new gems).

require "optparse"
require "yaml"
require_relative "../lib/clean_git_env"
require_relative "../lib/github_origin"
require_relative "../lib/fork_config"

class ForkFlow
  VERSION = "1.0.0"

  TEMPLATE_TOKEN  = "modelrails_base"
  TEMPLATE_MODULE = "ModelrailsBase"
  TEMPLATE_BRAND  = "ModelRails"
  FORK_FILE       = ForkConfig::FILE
  CHANGELOG       = "CHANGELOG.md"

  # Anchored on a path separator so a fork of your own named e.g.
  # "my_modelrails_base" is never mistaken for the template and silently
  # converted into a push-disabled upstream.
  TEMPLATE_REMOTE = %r{[:/]modelrails_base(\.git)?\z}

  # #789 — every git call below is `-C @root`-scoped, and `-C` LOSES to an
  # inherited GIT_DIR: with GIT_DIR set, `git -C x init` re-initialises $GIT_DIR
  # (flipping core.bare when $GIT_DIR is a worktree gitdir) and `git -C x config`
  # writes $GIT_DIR/config, which for a linked worktree is the shared repository
  # config. Git hooks export GIT_DIR (man 5 githooks), so anything invoking this
  # script from a hook inherits one.
  #
  # The GIT_CONFIG_* family is here for completeness rather than for #789 — hooks
  # do not export it — because any variable that can redirect a config write
  # belongs in this set: GIT_CONFIG sends `git config` writes to an arbitrary
  # file, and GIT_CONFIG_GLOBAL/SYSTEM/COUNT redirect or inject reads.
  # GIT_CEILING_DIRECTORIES is deliberately absent: it steers repository
  # discovery, which is already settled once GIT_DIR is nil.
  #
  # A nil value deletes the key in the child process, restoring `-C` precedence.
  # Passed as the first argument to every spawn — including bin/setup, which
  # shells git itself.
  CLEAN_GIT_ENV = ::CleanGitEnv::HASH

  # Single source of truth: which files carry template identity, and the exact
  # token in each. Static so spec/code_smells can assert the tokens still exist
  # upstream — a token that quietly disappears is indistinguishable from a
  # completed rename, and the script would congratulate itself while shipping
  # template branding.
  SUBSTITUTIONS = {
    "config/application.rb"            => [ [ "module #{TEMPLATE_MODULE}", :module_decl ] ],
    "config/deploy.yml"                => [ [ TEMPLATE_TOKEN, :snake ] ],
    "config/deploy.staging.yml"        => [ [ TEMPLATE_TOKEN, :snake ] ],
    "config/locales/en/brand.en.yml"   => [ [ %("#{TEMPLATE_BRAND}), :open_quoted_title ] ],
    "config/locales/en/pages.en.yml"   => [
      [ TEMPLATE_BRAND, :title ],
      # RFC-reserved .example makes the placeholder unmistakable; shipping the
      # template's real support address silently would be worse.
      [ "support@example.com", :support_email ]
    ],
    "public/manifest.webmanifest"      => [ [ %("#{TEMPLATE_BRAND}"), :quoted_title ] ],
    ".github/workflows/docker_build.yml" => [ [ "#{TEMPLATE_TOKEN}:", :snake_colon ] ],
    ".github/workflows/image_scan.yml"   => [ [ "#{TEMPLATE_TOKEN}:", :snake_colon ] ],
    ".github/workflows/hotcell_image_scan.yml" => [ [ "#{TEMPLATE_TOKEN}-hotcell:", :snake_hotcell_colon ] ]
  }.freeze

  RENAME_FILES = SUBSTITUTIONS.keys.freeze

  # Kept in step with config/initializers/tenancy.rb, which raises at boot on
  # anything else (pinned by a template invariant). Open SaaS is documented but
  # not implemented — offering it here would write a .env the app won't boot on.
  PRESETS = ForkConfig::PRESETS

  # Object.const_defined? catches Ruby core (always loaded), but this script is
  # stdlib-only by design — Rails and friends are NOT defined in its process, so
  # `--name rails` would sail through and write `module Rails` into
  # config/application.rb. Listed explicitly so the check behaves identically
  # here and under a spec suite that HAS loaded Rails.
  RESERVED_CONSTANTS = %w[
    Rails ActiveRecord ActiveSupport ActiveModel ActiveJob ActiveStorage
    ActionController ActionView ActionMailer ActionCable ActionText ActionDispatch
    Rack Puma Turbo Stimulus Pundit Capybara RSpec Minitest Bundler Gem
  ].freeze

  PRESET_DESCRIPTIONS = {
    "personal" => "Solo-default: every user gets a workspace on signup (shipped default)",
    "shared"   => "Single-tenant: one shared workspace, users join it",
    "none"     => "Workspace-optional: users sign up bare; workspaces created deliberately"
  }.freeze

  # Paths that reference the template by name forever, so the verify sweep must
  # not report them.
  TEMPLATE_OWNED_PATHS = [
    %r{\Aapp/docs/}, %r{\Aspec/}, %r{\AGemfile(\.lock)?\z},
    %r{\Abin/}, %r{\A\.gitattributes\z}, %r{\Avendor/}, %r{\A\.fork\.yml\z}
  ].freeze

  YOURS_TO_REWRITE_PATHS = [
    [ %r{\AREADME\.md\z},    "your product's README (fork-owned — rewrite wholesale)" ],
    [ %r{\A\.devcontainer/}, "optional: devcontainer bundle-cache volume name (see the forking guide)" ]
  ].freeze

  UI_GEM_LINE  = /modelrails_ui|\.modelrails_ui/i
  # Code namespaces upstream owns (cop department, theme JS global); renaming them only breaks sync.
  TEMPLATE_NAMESPACES = %r{ModelRails/\w|(?:rubocop|cop)/modelrails\b|\bmodule ModelRails\b|window\.ModelRails\b}
  COMMENT_LINE = %r{\A\s*(\#|//|\*|/\*|<%\#|<!--)}
  # The template documents its fork seams inside block comments — a /* */ in
  # _brand.css, a multi-line <%# %> in _footer.html.erb. Tracking open/close
  # lets the sweep see those instead of reporting correct prose as a rename
  # miss, and replaces a hand-maintained allow-list of the affected files.
  BLOCK_COMMENT_OPEN  = %r{/\*|<%\#|<!--}
  BLOCK_COMMENT_CLOSE = %r{\*/|%>|-->}
  # The shapes the fork_only placeholder check in template_invariants_spec.rb fails on.
  PLACEHOLDER_EMAIL = /[\w.+-]+@[\w.-]+\.example\b|[\w.+-]+@example\.com\b/
  # ReleaseFlow::Changelog::NAME with its parts named; this script runs before bundle install.
  RELEASE_TAG = /\Av(?<date>\d{4}\.\d{2}\.\d{2})(?:-(?<n>\d+))?\z/

  class Shell
    def initialize(root:, dry_run:, output:)
      @root = root
      @dry_run = dry_run
      @output = output
    end

    def run!(*cmd)
      @output.puts("  $ #{cmd.reject { |c| c == @root || c == '-C' }.join(' ')}")
      return true if @dry_run

      system(CLEAN_GIT_ENV, *cmd) || abort("bin/fork: command failed: #{cmd.join(' ')}")
    end

    def run(*cmd) = system(CLEAN_GIT_ENV, *cmd, chdir: @root)

    def capture(*cmd, err: File::NULL)
      out = IO.popen(CLEAN_GIT_ENV, cmd, err:, &:read)
      [ out.to_s.strip, $?.exitstatus ]
    end
  end

  class Console
    def initialize(input:, output:, dry_run:, yes:)
      @input = input
      @output = output
      @dry_run = dry_run
      @yes = yes
    end

    def say(msg)  = @output.puts(msg)
    def act(msg)  = @output.puts("#{@dry_run ? '[dry-run] would: ' : '  → '}#{msg}")
    def skip(msg) = @output.puts("  ✓ #{msg} (already done)")

    def prompts? = !@yes && @input.tty?
    def interactive? = !@dry_run && prompts?

    def ask(question, default)
      return default unless prompts?

      @output.print "#{question} [#{default}]: "
      answer = @input.gets.to_s.strip
      answer.empty? ? default : answer
    end
  end

  class GithubRepo
    def initialize(opts, root:, snake:, branch:, origin_present:, todos:, console:, shell:)
      @opts = opts
      @root = root
      @snake = snake
      @branch = branch
      @origin_present = origin_present
      @todos = todos
      @console = console
      @shell = shell
    end

    def origin_present? = @origin_present

    def add_origin(url)
      sh("git", "-C", @root, "remote", "add", "origin", url)
      @origin_present = true
      point_gh_at_origin!
    end

    # gh otherwise prefers the remote named upstream: the template.
    def point_gh_at_origin!
      sh("git", "-C", @root, "config", "remote.origin.gh-resolved", "base")
      # Without it, gh offers the template first when a branch isn't pushed yet.
      sh("git", "-C", @root, "config", "remote.pushDefault", "origin")
    end

    # Unknown (no gh, no GitHub origin) counts as present: nothing here can fix it.
    def rules_present?
      repo = GithubOrigin.repo(@root) or return true
      count, status = capture("gh", "api", "repos/#{repo}/rulesets", "--jq", "length")
      !status.zero? || count != "0"
    rescue Errno::ENOENT
      true
    end

    # True once origin holds this checkout's next; branch rules wait for that.
    def publish
      return github_dry_run if dry_run? && @opts[:github]
      return github_by_hand if dry_run? || @opts[:github] == false
      return github_by_hand(unasked: true) unless @opts[:github] || interactive?

      if @origin_present
        return github_by_hand unless push_to_origin?

        say("\n== GitHub ==")
        return next_branch? && push_next
      end

      login = github_login
      return github_by_hand(gh_missing: @opts[:github] && !login) unless login && create_github_repo?

      say("\n== GitHub ==")
      return false unless next_branch?

      owner, name = github_target(login)
      visibility = github_visibility(owner, login)
      url = github_url(owner, name)
      return false unless create_github_repo!(owner, name, visibility, url)

      add_origin(url)
      push_next
    end

    def protect
      return if @rules_blocked || !remote_next_matches?

      team = @opts[:team] || (interactive? && ask("Does a second person approve PRs? (y/N)", "N").match?(/\A[Yy]/))
      args = team ? [] : [ "--solo" ]
      say("\n== Branch rules ==\n  $ #{[ 'bin/branch-rules', *args ].join(' ')}")
      if @shell.run("bin/branch-rules", *args)
        say(team ? "  Rules need one approval per PR; bin/branch-rules --solo removes it." :
                   "  Rules are solo. A second approver later: bin/branch-rules (without --solo).")
      else
        @todos << "Protect the branches: #{[ 'bin/branch-rules', *args ].join(' ')}"
      end
    end

    private

    def snake = @snake
    def dry_run? = @opts[:dry_run]
    def interactive? = @console.interactive?
    def say(msg) = @console.say(msg)
    def act(msg) = @console.act(msg)
    def ask(question, default) = @console.ask(question, default)
    def sh(*cmd) = @shell.run!(*cmd)
    def capture(*cmd) = @shell.capture(*cmd)

    def manual_github_todos!
      @todos << if @origin_present
        "Push when ready: git push -u origin #{@branch}"
      else
        "Add your repository (create it EMPTY on GitHub first — no README/license):\n" \
          "     git remote add origin git@github.com:YOU/#{snake}.git && git push -u origin #{@branch}"
      end
      @todos << "Once your branch is on GitHub, protect the branches: bin/branch-rules " \
                "(add --solo if you merge your own PRs; /docs/developer/forking)"
    end

    def github_dry_run
      target = @opts[:github].is_a?(String) ? @opts[:github] : "YOU/#{snake}"
      target = "#{target}/#{snake}" unless target.include?("/")
      act("create the GitHub repo #{target} (#{@opts[:visibility] || 'public'})") unless @origin_present
      act("git push -u origin next")
      act("bin/branch-rules#{' --solo' unless @opts[:team]}")
      false
    end

    def github_by_hand(gh_missing: false, unasked: false)
      say("\n  ! gh isn't installed or signed in, so the GitHub steps are listed by hand.") if gh_missing
      say_how_to_publish if unasked
      manual_github_todos!
      false
    end

    # Nobody was there to choose the owner, so the run names the flag that does.
    def say_how_to_publish
      if @origin_present
        say("\n  ! Not pushed to origin: nobody was asked. To push and protect: bin/fork --github")
      else
        say("\n  ! Not published to GitHub: nobody chose the owner. To publish: bin/fork --github OWNER")
      end
    end

    def push_to_origin?
      return true if @opts[:github]

      interactive? && ask("\nPush next to origin and protect it? (Y/n)", "Y").match?(/\A[Yy]/)
    end

    def next_branch?
      return true if @branch == "next"

      say("  ! The GitHub step pushes next, but this checkout is on #{@branch}.")
      @todos << "Switch to the branch with the rename, merge it into next, push next, then: bin/branch-rules --solo"
      false
    end

    def remote_next_matches?
      remote, status = capture("git", "-C", @root, "ls-remote", "origin", "refs/heads/next")
      head, = capture("git", "-C", @root, "rev-parse", "HEAD")
      status.zero? && remote.split.first == head
    end

    def github_login
      _, status = capture("gh", "auth", "status")
      return nil unless status.zero?

      login, = capture("gh", "api", "user", "--jq", ".login")
      login unless login.empty?
    rescue Errno::ENOENT
      nil
    end

    def create_github_repo?
      return true if @opts[:github]

      interactive? && ask("\nCreate the GitHub repo and push next to it? (Y/n)", "Y").match?(/\A[Yy]/)
    end

    def github_target(login)
      given = @opts[:github] if @opts[:github].is_a?(String)
      if given.nil? && interactive?
        orgs, = capture("gh", "api", "user/orgs", "--jq", ".[].login")
        say("  Your organizations: #{orgs.split.join(', ')}") unless orgs.empty?
        given = ask("GitHub owner (or OWNER/NAME)", login)
      end
      owner, name = (given || login).split("/", 2)
      [ owner, name || snake ]
    end

    def github_visibility(owner, login)
      answer = @opts[:visibility] || (interactive? ? ask("Public or private?", "public") : "public")
      visibility = answer.match?(/\Apriv/i) ? "private" : "public"
      return visibility unless visibility == "private" && free_plan?(owner, login)

      say("  ! #{owner} is on GitHub's free plan: a private repo there can't have branch rules, " \
          "and its Actions minutes are capped.")
      return "public" if interactive? && ask("Make it public instead? (Y/n)", "Y").match?(/\A[Yy]/)

      @rules_blocked = true
      @todos << "Your private repo on GitHub's free plan has no branch rules. " \
                "After upgrading the plan, or making the repo public: bin/branch-rules --solo"
      visibility
    end

    def free_plan?(owner, login)
      plan, status = capture("gh", "api", owner == login ? "user" : "orgs/#{owner}", "--jq", ".plan.name")
      status.zero? && plan == "free"
    end

    def github_url(owner, name)
      protocol, = capture("gh", "config", "get", "git_protocol", "-h", "github.com")
      protocol == "https" ? "https://github.com/#{owner}/#{name}.git" : "git@github.com:#{owner}/#{name}.git"
    end

    def create_github_repo!(owner, name, visibility, url)
      act("create the GitHub repo #{owner}/#{name} (#{visibility})")
      out, status = @shell.capture("gh", "repo", "create", "#{owner}/#{name}", "--#{visibility}", err: [ :child, :out ])
      return true if status&.zero?

      say("  ! gh repo create #{owner}/#{name} failed: #{out}\n    Nothing was pushed; the rename is committed here.")
      @todos << "Create the GitHub repo: fix the error above and rerun bin/fork --github #{owner}/#{name}, " \
                "or, if the repo already exists: bin/fork --origin #{url} --github"
      false
    end

    def push_next
      say("  $ git push -u origin next")
      return true if @shell.run("git", "-C", @root, "push", "-u", "origin", "next")

      say("  ! The push failed, so the branches are not protected yet.")
      @todos << "Push the rename: git push -u origin next"
      @todos << "Then protect the branches: bin/branch-rules --solo"
      false
    end
  end

  attr_reader :todos

  def self.placeholder_email?(address) = !address.include?("@") || address.match?(PLACEHOLDER_EMAIL)

  def initialize(options, root: Dir.pwd, input: $stdin, output: $stdout, shell: nil)
    @opts = options
    @root = File.expand_path(root)
    @todos = []
    @console = Console.new(input:, output:, dry_run: options[:dry_run], yes: options[:yes])
    @shell = shell || Shell.new(root: @root, dry_run: options[:dry_run], output:)
  end

  def run
    preflight!

    if forked?
      return update_preset! if @opts[:preset]

      return resume_forked!
    end

    collect_answers!
    step_release!
    step_remotes!
    step_rename!
    step_preset!(@preset)
    step_verify!
    @github.protect if @github.publish
    @todos << "Set up outbound mail, which production requires: bin/mail-setup"
    print_summary!
    offer_mail_setup! if offer_setup!
  end

  # ------------------------------------------------------------------ naming

  def snake = @snake
  def camel = snake.split(/_+/).map(&:capitalize).join
  def title = snake.split(/_+/).map(&:capitalize).join(" ")

  def replacement_for(key)
    {
      module_decl:       "module #{camel}",
      snake:             snake,
      snake_colon:       "#{snake}:",
      snake_hotcell_colon: "#{snake}-hotcell:",
      title:            title,
      quoted_title:      %("#{title}"),
      open_quoted_title: %("#{title}),
      support_email:     support_email
    }.fetch(key)
  end

  # ------------------------------------------------------------------- state

  # Derived from HEAD, not the worktree. Reading the worktree would flip this
  # true the instant the first file is written — so an interrupted rename would
  # route every later run down the "already forked" path and never finish.
  def identity_renamed?
    content, status = capture("git", "-C", @root, "show", "HEAD:config/application.rb")
    status.zero? && !content.include?("module #{TEMPLATE_MODULE}")
  end

  # Recorded provenance is the completion marker: renamed AND recorded.
  def forked? = identity_renamed? && File.exist?(path_to(FORK_FILE))

  def upstream_configured?
    url, url_status = capture("git", "-C", @root, "remote", "get-url", "upstream")
    push_url, = capture("git", "-C", @root, "remote", "get-url", "--push", "upstream")
    url_status.zero? && template_remote?(url) && push_url == "DISABLED"
  end

  # A synced mirror of the template lives under another name, so the name
  # pattern can't know it; --template names it, and only URL equality
  # (.git-insensitive) matches — never a looser pattern, for the reason above.
  def template_remote?(url)
    return true if url.match?(TEMPLATE_REMOTE)

    given = @opts[:template].to_s
    !given.empty? && normalize_url(url) == normalize_url(given)
  end

  def normalize_url(url) = url.to_s.strip.delete_suffix(".git").chomp("/")

  # Git has no record of what a fork was forked from; GitHub does. Asked only
  # when nothing else names the template, and answered only when `gh` is
  # installed and origin is a GitHub repo with a parent — otherwise --template.
  def github_parent(origin_url)
    match = origin_url.match(%r{github\.com[:/](?<owner>[^/]+)/(?<repo>[^/]+?)(?:\.git)?/?\z})
    return nil unless match

    field = origin_url.start_with?("https://") ? "clone_url" : "ssh_url"
    url, status = capture("gh", "api", "repos/#{match[:owner]}/#{match[:repo]}", "--jq", ".parent.#{field} // empty")
    status.zero? && !url.empty? ? url : nil
  rescue Errno::ENOENT
    nil
  end

  def current_branch
    branch, = capture("git", "-C", @root, "rev-parse", "--abbrev-ref", "HEAD")
    branch.empty? ? "main" : branch
  end

  # ------------------------------------------------------------------- steps

  def preflight!
    abort("bin/fork: run from the application root (config/application.rb not found)") unless File.exist?(path_to("config/application.rb"))
    abort("bin/fork: not a git repository") unless Dir.exist?(path_to(".git"))

    # Checked before any remote surgery so a fork that deleted a rename target
    # (plenty won't use Kamal) fails with a sentence, not an Errno backtrace
    # halfway through.
    missing = RENAME_FILES.reject { |f| File.exist?(path_to(f)) }
    unless missing.empty? || forked?
      abort("bin/fork: rename targets are missing, cannot proceed:\n  #{missing.join("\n  ")}")
    end

    return if dry_run? || forked?

    # This script commits on your behalf, and a fresh laptop, container, or CI
    # runner may have no identity configured. Say so now rather than dying on
    # `fatal: empty ident name` after the remote surgery has already happened.
    _, ident_status = capture("git", "-C", @root, "var", "GIT_COMMITTER_IDENT")
    unless ident_status.zero?
      abort(<<~MSG)
        bin/fork: git has no identity configured, so the rename commit would fail
        partway through. Set one first:
          git config --global user.name "Your Name"
          git config --global user.email "you@example.com"
      MSG
    end

    dirty, = capture("git", "-C", @root, "status", "--porcelain")
    return if dirty.empty?

    # The likeliest interruption is "files written, commit never made" — a
    # Ctrl-C, a machine with no git identity, a failing pre-commit hook. Those
    # dirty paths are OUR work, and refusing them would tell the user to stash
    # their own half-finished rename. Anything else is genuinely theirs.
    # Parsed by pattern, not fixed columns: `capture` strips the whole output,
    # so porcelain's leading status space is gone on the first line only.
    # Anything unrecognized (a rename's "old -> new") falls through as theirs,
    # which fails closed.
    ours = RENAME_FILES + [ FORK_FILE ]
    theirs = dirty.lines.map { |line| line.strip.sub(/\A\S{1,2}\s+/, "").delete('"') } - ours
    return say("  · resuming an interrupted rename (working tree has only bin/fork's own edits)") if theirs.empty?

    abort(<<~MSG)
      bin/fork: working tree is not clean. The identity rename wants to be one
      clean commit you can always find again — commit or stash first:
        #{theirs.join("\n  ")}
    MSG
  end

  def collect_answers!
    @snake = normalize_name(@opts[:name] || ask("Project name?", File.basename(@root)))
    @preset = @opts[:preset] || (ask_preset if @console.prompts?)
    validate_preset!(@preset) if @preset
    @support_email = collect_support_email
    check_github_flags!
    if @opts[:github] && current_branch != "next"
      abort("bin/fork: --github pushes next, but this checkout is on #{current_branch}. " \
            "Run git switch next, then rerun bin/fork.")
    end

    say("Project: #{snake}  (module #{camel} · product \"#{title}\" · preset #{@preset || 'undecided'})")
  end

  # A name reaches config/application.rb as a Ruby module declaration, so an
  # unusable one produces a committed app that cannot boot. The directory name
  # is the default, so `git clone … 5by5 && bin/fork` gets here with no flags.
  def normalize_name(raw)
    raw = raw.to_s
    # Silent transliteration is how you discover months later that your module
    # and Kamal service are named after a word you didn't choose.
    unless raw.ascii_only?
      abort("bin/fork: #{raw.inspect} contains non-ASCII characters, which would be " \
            "dropped rather than transliterated — pass --name with an ASCII name")
    end

    name = raw.downcase.gsub(/[^a-z0-9]+/, "_").gsub(/\A_+|_+\z/, "")

    abort("bin/fork: could not derive a project name from #{raw.inspect} — pass --name") if name.empty?
    abort("bin/fork: project name is still the template's — pass --name") if name == TEMPLATE_TOKEN
    unless name.match?(/\A[a-z][a-z0-9_]*\z/)
      abort("bin/fork: #{name.inspect} cannot become a Ruby module name (it must start " \
            "with a letter) — pass --name with something like my_app")
    end

    constant = name.split(/_+/).map(&:capitalize).join
    if RESERVED_CONSTANTS.include?(constant) || Object.const_defined?(constant, false)
      abort("bin/fork: module #{constant} would collide with the existing constant " \
            "::#{constant} — pass --name with something else")
    end

    name
  end

  def validate_preset!(preset)
    return if PRESETS.include?(preset)

    extra = preset == "open_saas" ? " Open SaaS is documented but not shipped yet (see /docs/developer/presets-open-saas) — start on personal." : ""
    abort("bin/fork: unknown preset #{preset.inspect} (choose from #{PRESETS.join('/')}).#{extra}")
  end

  def ask_preset
    say("  Workspace-on-signup preset (docs: /docs/developer/presets):")
    PRESETS.each_with_index { |p, i| say("    #{i + 1}) #{p} — #{PRESET_DESCRIPTIONS[p]}") }
    answer = ask("  Choose 1-#{PRESETS.size}, or blank to defer", "")
    PRESETS[Integer(answer) - 1] if answer.match?(/\A[1-#{PRESETS.size}]\z/)
  end

  # nil means "use the placeholder": the fork_only spec then keeps CI red until it's set.
  def collect_support_email
    if (given = @opts[:support_email])
      return given unless self.class.placeholder_email?(given)

      abort("bin/fork: #{given.inspect} isn't a real support address (CI rejects *.example and example.com)")
    end

    loop do
      answer = ask("Support address (where users write for help; blank to set later)", "")
      return nil if answer.empty?
      return answer unless self.class.placeholder_email?(answer)

      say("  ! #{answer.inspect} isn't a real address; CI rejects *.example and example.com.")
    end
  end

  def support_email = @support_email || "support@#{snake}.example"

  def step_release!
    say("\n== Starting point ==")
    reason = release_skip_reason
    return say("  · #{reason}, so the fork starts from #{current_branch} as it is") if reason

    remote = release_remote
    @release = latest_release(remote)
    return say("  ! no release tag on #{remote}/main, so the fork starts from next as cloned") unless @release

    target, = capture("git", "-C", @root, "rev-parse", "#{@release}^{commit}")
    head, = capture("git", "-C", @root, "rev-parse", "HEAD")
    return say("  ✓ next is already at the template's release #{@release}") if head == target

    refuse_unpushed_commits!(remote)
    act("move next to the template's latest release #{@release} (bin/fork --from-next keeps unreleased work)")
    sh("git", "-C", @root, "reset", "-q", "--keep", target)
  end

  def release_skip_reason
    return "--from-next" if @opts[:from_next]
    return "this checkout is on #{current_branch}" unless current_branch == "next"
    return "the identity rename is already committed" if identity_renamed?
    return "an interrupted run already chose the starting point" unless capture("git", "-C", @root, "status", "--porcelain").first.empty?

    "origin is your own repository" unless release_remote
  end

  # Only while nothing of the fork's is on a remote: moving next back would make its push a non-fast-forward.
  def release_remote
    origin_url, origin_status = capture("git", "-C", @root, "remote", "get-url", "origin")
    return "origin" if origin_status.zero? && template_remote?(origin_url)

    "upstream" if !origin_status.zero? && upstream_configured?
  end

  def latest_release(remote)
    unless dry_run?
      _, status = capture("git", "-C", @root, "fetch", "-q", "--tags", remote)
      say("  ! couldn't reach #{remote}, so this uses the releases the clone already knows") unless status.zero?
    end
    tags, = capture("git", "-C", @root, "tag", "--list", "v*", "--merged", "refs/remotes/#{remote}/main")
    tags.split.filter_map { |tag| tag.match(RELEASE_TAG) }.max_by { |m| [ m[:date], m[:n].to_i ] }&.string
  end

  def refuse_unpushed_commits!(remote)
    unpushed, = capture("git", "-C", @root, "rev-list", "HEAD", "--not", "--remotes")
    return if unpushed.empty?

    abort(<<~MSG)
      bin/fork: next has commits that #{remote} doesn't, and moving next to #{@release}
      would drop them. Put them on a branch of their own (git branch my-work), then
      git reset --keep #{remote}/next and rerun; or fork from them with bin/fork --from-next.
    MSG
  end

  def step_remotes!
    say("\n== Remotes ==")
    origin_url, origin_status = capture("git", "-C", @root, "remote", "get-url", "origin")
    origin_present = origin_status.zero?
    origin_is_template = origin_present && template_remote?(origin_url)
    @template_url = @opts[:template] || (origin_is_template ? origin_url : nil)
    @baseline_sha, = capture("git", "-C", @root, "rev-parse", "HEAD")

    if upstream_configured?
      skip("upstream remote configured, push DISABLED")
      @template_url ||= capture("git", "-C", @root, "remote", "get-url", "upstream").first
    elsif origin_is_template && upstream_taken?
      # Diagnosed before the first mutation: `remote rename` would fail on the
      # existing name, leaving origin's push URL already disabled and the user
      # stranded halfway through the surgery.
      abort(<<~MSG)
        bin/fork: an `upstream` remote already exists but isn't the template with
        push DISABLED, so the remote surgery can't proceed safely. Inspect it:
          git remote -v
        Then either fix it by hand (see /docs/developer/forking) or remove it:
          git remote remove upstream
      MSG
    elsif origin_is_template
      # Push URL first: if the rename succeeded and this failed, the fork would
      # be left with a live, writable push URL aimed at the template.
      sh("git", "-C", @root, "remote", "set-url", "--push", "origin", "DISABLED")
      sh("git", "-C", @root, "remote", "rename", "origin", "upstream")
      # `remote rename` repoints branch.<name>.remote, so until an origin
      # exists `git pull` would merge the TEMPLATE into your work.
      sh("git", "-C", @root, "branch", "--unset-upstream") if tracking_branch?
      origin_present = false
    elsif (@template_url ||= (github_parent(origin_url) unless @opts[:origin]))
      how = @opts[:template] ? "--template" : "origin's GitHub parent"
      say("  ✓ template #{@template_url} (#{how}) — bin/setup adds it as the push-disabled upstream remote")
      unless @opts[:template]
        @todos << "On GitHub: Settings → General → Leave fork network, so PRs default to your repo, " \
                  "not the template (bin/sync keeps working: it reads .fork.yml)."
      end
    else
      say("  ! no template remote found to convert — verify by hand:")
      say("    git remote -v   # upstream fetch = the template, upstream push = DISABLED")
      say("    or name it: bin/fork --template URL")
    end

    @github = github_repo(origin_present)
    if origin_present
      skip("origin remote present (#{origin_url})")
      say("  ! --origin ignored: an origin remote already exists") if @opts[:origin]
      @github.point_gh_at_origin!
    elsif @opts[:origin]
      @github.add_origin(@opts[:origin])
    end
  end

  def github_repo(origin_present)
    GithubRepo.new(@opts, root: @root, snake:, branch: current_branch, origin_present:,
                          todos: @todos, console: @console, shell: @shell)
  end

  def upstream_taken?
    _, status = capture("git", "-C", @root, "remote", "get-url", "upstream")
    status.zero?
  end

  def tracking_branch?
    _, status = capture("git", "-C", @root, "rev-parse", "--abbrev-ref", "@{u}")
    status.zero?
  end

  def step_rename!
    say("\n== Identity rename ==")

    # Every file is read and rewritten in memory BEFORE anything is written, so
    # a surprise mid-way leaves the tree untouched rather than half-renamed.
    planned = {}
    SUBSTITUTIONS.each do |path, substitutions|
      content = File.read(path_to(path))
      applied = []
      substitutions.each do |from, key|
        next unless content.include?(from)

        to = replacement_for(key)
        content = content.gsub(from, to)
        applied << [ from, to ]
      end
      planned[path] = [ content, applied ] unless applied.empty?
    end

    if planned.empty?
      skip("identity rename")
    else
      planned.each do |path, (content, applied)|
        applied.each { |from, to| act(%(#{path}: "#{from}" → "#{to}")) }
        atomic_write(path_to(path), content) unless dry_run?
      end
    end
    (RENAME_FILES - planned.keys).each { |path| skip(path) }

    act("write #{FORK_FILE} (template_url: #{@template_url || 'none'} — committed provenance — see the forking guide)")
    write_fork_file(
      "name"                => snake,
      "product_name"        => title,
      "preset"              => @preset,
      "template_url"        => @template_url,
      "template_baseline"   => @baseline_sha,
      "template_release"    => @release,
      "forked_at"           => Time.now.strftime("%Y-%m-%d"),
      "fork_script_version" => VERSION
    )

    @todos << "Rewrite the product description in config/locales/en/brand.en.yml " \
              "(still the template's sentence — bin/fork renames, it doesn't write your copy)."
    unless @support_email
      @todos << "Set a real support address in config/locales/en/pages.en.yml " \
                "(now #{support_email}; CI fails until it is set): edit, then commit."
    end
    @todos << "Rewrite marketing copy: config/locales/en/pages.en.yml + app/views/pages/ (fork-owned)."
    @todos << "Replace the brand mark: app/views/shared/_site_mark.html.erb (one <svg>) and the icon set in public/ " \
              "(fork-owned — bin/fork renames strings, never artwork)."
    @todos << "Name your nouns, if the product's aren't workspace/project: config/vocabulary.local.yml " \
              "(fork-owned — every template string follows, and so do yours when they say %{project}, not the word)."

    act("start #{CHANGELOG} clean (the template's releases stay on its releases page; bin/sync links each one it brings in)")
    atomic_write(path_to(CHANGELOG), "# Changelog\n\nAll notable changes to #{title} are documented here.\n\n## [Unreleased]\n") unless dry_run?

    commit!("Rename identity: #{title}", FORK_FILE, CHANGELOG, *RENAME_FILES)
  end

  def step_preset!(preset)
    say("\n== Tenancy preset ==")

    if preset.nil?
      say("  ! no preset chosen — skipped. This is a set-up-time decision (switching")
      say("    later is a migration, not a config flip).")
      @todos << "Choose the tenancy preset: bin/fork --preset #{PRESETS.join('|')} (docs: /docs/developer/presets)"
      return
    end

    write_env(ForkConfig.new("preset" => preset, "name" => snake_for_slug).tenancy_defaults)

    say(<<~NOTE)

      NOTE: these live in .env for development, and production reads the preset from .fork.yml.
      Do NOT `export` them in your shell: the suite asserts the DEFAULT preset, and an
      exported value leaks into rspec and fails hundreds of specs.
    NOTE

    return unless preset == "none"

    say(<<~NOTE)
      :none extra: do NOT override authenticated_home_path until the route you
      want exists — and when you do, delegate to `super` (see /docs/developer/presets-none).
    NOTE
  end

  def snake_for_slug = @snake || fork_config.name || "main"

  # Recording a preset change on an already-forked repo.
  def update_preset!
    preset = @opts[:preset]
    validate_preset!(preset)

    if fork_config.preset == preset
      skip("preset already recorded as #{preset}")
      return step_preset!(preset)
    end

    say("== Recording tenancy preset: #{preset} ==")
    if fork_config.preset
      say("  ! changing preset #{fork_config.preset} → #{preset}. On a LIVE app this is")
      say("    a migration, not a config flip (/docs/developer/presets) — existing data")
      say("    keeps its old shape. Fine before launch; deliberate afterwards.")
    end

    write_fork_file(fork_config.to_h.merge("preset" => preset))
    commit!("Record tenancy preset: #{preset}", FORK_FILE)
    step_preset!(preset)
    print_summary!
  end

  # A forked repo can still lack a real support address, an origin, or branch rules.
  def resume_forked!
    report_already_forked!
    @snake = fork_config.name
    check_github_flags!
    set_support_address_on_fork!
    _, status = capture("git", "-C", @root, "remote", "get-url", "origin")
    @github = github_repo(status.zero?)
    @github.add_origin(@opts[:origin]) if !@github.origin_present? && @opts[:origin]
    return unless @opts[:github] || interactive?
    return if @github.origin_present? && @github.rules_present?

    @github.protect if @github.publish
    print_summary!
  end

  def set_support_address_on_fork!
    path = "config/locales/en/pages.en.yml"
    content = File.read(path_to(path))
    placeholder = content[PLACEHOLDER_EMAIL]
    return unless placeholder && (address = collect_support_email)

    dirty, = capture("git", "-C", @root, "status", "--porcelain", "--", path)
    unless dirty.empty?
      say("  ! #{path} has uncommitted edits, so the support address wasn't set.")
      return @todos << "Commit or stash your edits to #{path}, then set the support address: " \
                       "bin/fork --support-email #{address}"
    end

    act(%(#{path}: "#{placeholder}" → "#{address}"))
    return if dry_run?

    atomic_write(path_to(path), content.gsub(placeholder, address))
    commit!("Set the support address", path)
  end

  def report_already_forked!
    say("== #{fork_config.product_name || 'This repo'} is already forked ==")
    say("  Nothing renamed — the identity rename is committed (#{FORK_FILE} records it).")
    say("  Per-clone setup (upstream remote, merge driver, .env preset) is bin/setup.")
    say("\nNext: bin/setup")
  end

  def check_github_flags!
    return unless @opts[:origin] && @opts[:github].is_a?(String)

    abort("bin/fork: use --github OWNER on its own, or --origin URL --github (push to a repo that exists)")
  end

  def step_verify!
    say("\n== Verify ==")
    if dry_run?
      say("  · skipped under --dry-run (nothing was written, so every rename target")
      say("    would still report as a leftover)")
      return {}
    end

    # git grep, not grep: it searches TRACKED files only. A plain working-tree
    # grep reports thousands of hits from worktrees, graphify-out/, and other
    # untracked artifacts, burying the handful that matter.
    out, status = capture("git", "-C", @root, "grep", "-Ili", "modelrails")
    # git grep: 0 = matches, 1 = clean, anything else = the check did not run.
    abort("bin/fork: verify sweep failed to run (git grep exit #{status})") if status > 1

    triage = out.split("\n").each_with_object(Hash.new { |h, k| h[k] = [] }) do |file, acc|
      acc[classify(file)] << file
    end

    if triage[:live].empty?
      say("  ✓ no live template tokens outside template-owned files")
    else
      say("  ✗ probable rename misses — live template tokens remain:")
      triage[:live].each { |f| say("      #{f}   (git grep -n modelrails #{f})") }
    end
    say("  · comment-only mentions (harmless seam docs): #{triage[:comment].join(', ')}") if triage[:comment].any?
    triage[:rewrite].each do |file|
      @todos << "#{file} — #{YOURS_TO_REWRITE_PATHS.find { |p, _| file.match?(p) }.last}"
    end

    triage
  end

  def classify(file)
    return :template_owned if TEMPLATE_OWNED_PATHS.any? { |p| file.match?(p) }
    return :rewrite        if YOURS_TO_REWRITE_PATHS.any? { |p, _| file.match?(p) }

    lines = File.read(path_to(file)).lines(chomp: true)
    matching = lines.each_index.select { |i| lines[i].match?(/modelrails/i) }
    # modelrails_ui is a gem this app names forever — not a leftover to report.
    matching -= matching.select { |i| lines[i].match?(UI_GEM_LINE) }
    return :gem_reference if matching.empty?

    matching.select! { |i| lines[i].gsub(TEMPLATE_NAMESPACES, "").match?(/modelrails/i) }
    return :template_namespace if matching.empty?

    commentary = commentary_lines(lines)
    matching.all? { |i| commentary.include?(i) } ? :comment : :live
  end

  # Indices of lines that are commentary, including those inside a block that
  # opened on an earlier line.
  def commentary_lines(lines)
    inside = false
    lines.each_with_index.with_object([]) do |(line, i), acc|
      opens = line.match?(BLOCK_COMMENT_OPEN)
      closes = line.match?(BLOCK_COMMENT_CLOSE)
      acc << i if inside || opens || line.match?(COMMENT_LINE)
      inside = true if opens && !closes
      inside = false if closes
    end
  end

  # The first developer always needs bin/setup next, and this is the moment they
  # are least oriented — so offer it rather than making them find the command.
  # Only ever offered: --yes and non-TTY runs (CI, orchestrators) stay fast and
  # deterministic instead of silently carrying a full environment bootstrap.
  def offer_setup!
    return false unless interactive?
    return false unless ask("\nRun bin/setup now? (installs dependencies, prepares the database)", "Y").match?(/\A[Yy]/)

    say("\n== Running bin/setup ==")
    # --skip-server: bin/setup ends with `exec bin/dev`, which would replace this
    # process and start a server nobody asked for.
    return true if @shell.run("bin/setup", "--skip-server")

    say("\n  ! bin/setup failed — but the fork itself is already committed, so there")
    say("    is nothing here to redo. Fix the setup problem and re-run bin/setup.")
    false
  end

  def offer_mail_setup!
    return unless interactive?

    if ask("\nSet up outbound mail now?", "N").match?(/\A[Yy]/)
      say("\n== Running bin/mail-setup ==")
      return if @shell.run("bin/mail-setup")
    end

    say("\n  ! Mail isn't set up, so production will refuse to boot until it is.")
    say("    Run bin/mail-setup when ready; development mail keeps working locally.")
  end

  def interactive? = @console.interactive?

  def print_summary!
    return if @todos.empty?

    say("\n== Next steps ==")
    @todos.each_with_index { |todo, i| say("  #{i + 1}. #{todo}") }
    say("  #{@todos.size + 1}. Set up and prove green:  bin/setup --skip-server && bin/parallel-rspec")
    say("  #{@todos.size + 2}. Deploy later: Fork to Served, /docs/developer/quickstart, from step 4.")
  end

  private

  # ----------------------------------------------------------------- helpers

  def dry_run? = @opts[:dry_run]
  def path_to(relative) = File.join(@root, relative)

  def say(msg)  = @console.say(msg)
  def act(msg)  = @console.act(msg)
  def skip(msg) = @console.skip(msg)
  def ask(question, default) = @console.ask(question, default)

  def sh(*cmd) = @shell.run!(*cmd)
  def capture(*cmd) = @shell.capture(*cmd)

  # Pathspec-limited so a developer's unrelated staged work never lands in the
  # identity commit — "one clean commit you can always find again" has to mean it.
  def commit!(message, *paths)
    return if dry_run?

    sh("git", "-C", @root, "add", "--", *paths)
    # `diff --cached --quiet` exits 0 when nothing is staged for these paths —
    # committing then would abort on "nothing to commit", breaking re-runs.
    _, status = capture("git", "-C", @root, "diff", "--cached", "--quiet", "--", *paths)
    return skip("nothing to commit for: #{message}") if status.zero?

    sh("git", "-C", @root, "commit", "-m", message, "--", *paths)
  end

  # .fork.yml is committed and hand-editable, so it will be hand-edited. A raw
  # Psych backtrace names neither the file nor the fix.
  def fork_config
    @fork_config ||= ForkConfig.read(@root)
  rescue Psych::Exception => e
    abort("bin/fork: #{FORK_FILE} is not valid YAML (#{e.message.lines.first.to_s.strip}). " \
          "Fix it by hand, or delete it and re-run — nothing gates on it.")
  end

  def write_fork_file(data)
    return if dry_run?

    header = <<~HEADER

      # Fork provenance, written by bin/fork. Do not gate on this file; live state comes from the repository.

      # Committed so every clone inherits the decisions: bin/setup reads `preset`, and `template_baseline` is the cut point.

    HEADER
    atomic_write(path_to(FORK_FILE), header + YAML.dump(data.compact))
    @fork_config = nil
  end

  def write_env(vars)
    path = path_to(".env")
    env = File.exist?(path) ? File.read(path) : ""

    pending = vars.reject { |k, v| env.match?(/^#{Regexp.escape("#{k}=#{v}")}$/) }
    return skip(".env already sets #{vars.keys.join(', ')}") if pending.empty?

    pending.each { |k, v| act("write #{k}=#{v} to .env (gitignored, for development)") }
    return if dry_run?

    pending.each_key { |k| env = env.gsub(/^#{Regexp.escape(k)}=.*\n?/, "") }
    env += "\n" unless env.empty? || env.end_with?("\n")
    atomic_write(path, env + pending.map { |k, v| "#{k}=#{v}\n" }.join, mode: 0o600)
  end

  # .env is gitignored — the only state here with no backup anywhere. A plain
  # File.write truncates first, so an interrupt destroys it.
  def atomic_write(path, content, mode: nil)
    tmp = "#{path}.bin-fork-#{Process.pid}"
    File.write(tmp, content)
    File.chmod(mode, tmp) if mode
    File.rename(tmp, path)
  end
end

if $PROGRAM_NAME == __FILE__
  options = {}
  OptionParser.new do |o|
    o.banner = "Usage: bin/fork [options]   (fork once, setup often)"
    o.on("--name NAME", "Project name (default: directory name; snake_cased)") { |v| options[:name] = v }
    o.on("--origin URL", "Your repository's git URL (becomes the origin remote)") { |v| options[:origin] = v }
    o.on("--template URL", "The template's git URL when it is a mirror under another name (recorded in .fork.yml; an origin or upstream equal to it counts as the template)") { |v| options[:template] = v }
    o.on("--support-email ADDRESS", "Where users write for help (default: a placeholder CI refuses)") { |v| options[:support_email] = v }
    o.on("--github [OWNER[/NAME]]", "Create the GitHub repo (default owner: you; name: the project), push next, protect it") { |v| options[:github] = v || true }
    o.on("--no-github", "Skip GitHub; print the steps instead") { options[:github] = false }
    o.on("--public", "New GitHub repo is public (default)") { options[:visibility] = "public" }
    o.on("--private", "New GitHub repo is private") { options[:visibility] = "private" }
    o.on("--team", "Branch rules require one approval (default: solo)") { options[:team] = true }
    o.on("--preset PRESET", "Tenancy preset: #{ForkFlow::PRESETS.join('/')}") { |v| options[:preset] = v }
    o.on("--from-next", "Start from next as cloned, unreleased template work included (default: the latest release)") { options[:from_next] = true }
    o.on("--yes", "Non-interactive: accept defaults, never prompt") { options[:yes] = true }
    o.on("--dry-run", "Print the plan without changing anything") { options[:dry_run] = true }
  end.parse!

  ForkFlow.new(options, root: File.expand_path("..", __dir__)).run
end
