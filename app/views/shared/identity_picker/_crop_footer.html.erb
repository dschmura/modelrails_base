<%# locals: (form_url:) -%>
<div class="sm:col-span-full flex flex-col gap-3 pt-4 border-t border-border">
  <div class="flex items-center justify-end gap-3">
    <button type="button"
            data-action="click->identity-picker#backToHub"
            class="btn-secondary text-sm">
      <%= t("identity_picker.cancel") %>
    </button>
    <button type="button"
            data-action="click->identity-picker#saveCrop"
            class="btn-primary text-sm">
      <%= t("identity_picker.save_crop") %>
    </button>
  </div>
  <div class="flex items-center justify-between">
    <%# Native label/input activation: clicking or Enter/Space-activating this
        label forwards to the associated file input, which opens the OS file
        dialog. No `for` here in markup and no .click() call needed — the
        controller wires `for` onto whichever of this label and the hub's
        upload label is currently visible (identity_picker_controller.js
        #_syncFileLabel), since the shared file input can only ever have one
        genuinely-visible <label> at a time. %>
    <label data-identity-picker-target="cropUploadLabel"
           class="btn-text-icon btn-text-interactive text-sm px-2 inline-flex items-center min-h-11 cursor-pointer">
      <%= icon(:arrow_up_tray, size: :sm) %>
      <%= t("identity_picker.upload_new") %>
    </label>
    <%= button_to form_url,
          method: :delete,
          class: "btn-text-icon btn-text-danger text-sm px-2 bg-transparent border-0 cursor-pointer",
          data: { turbo_frame: "_top" } do %>
      <%= icon(:trash, size: :sm) %>
      <%= t("identity_picker.remove_photo") %>
    <% end %>
  </div>
</div>
