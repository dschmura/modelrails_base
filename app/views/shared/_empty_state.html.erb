<%# locals: (message:, action_text: nil, action_url: nil) -%>
<%# The icon carries mb-3 here rather than coming spaced from the component:
    UI::EmptyStateComponent centers and sizes a slotted svg but puts no gap
    before the title, so without this the icon sits flush on the message
    (modelrails_ui#241). Drop it once that ships. -%>
<%= ui :empty_state, title: message do |c| %>
  <% c.with_icon { icon(:information_circle, class: "mb-3") } %>
  <% if action_text && action_url %>
    <% c.with_action do %>
      <%= link_to action_text, action_url,
            class: "inline-flex items-center px-4 py-2 min-h-input rounded-md text-sm font-medium
                    text-interactive hover:text-interactive-hover
                    focus-ring" %>
    <% end %>
  <% end %>
<% end %>
