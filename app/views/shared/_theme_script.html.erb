<%# Deviation: the only inline script tag in a view. It must set the `dark` class
    on the html root BEFORE first paint, so it cannot live in the `theme` Stimulus
    controller (importmap modules are deferred and would paint the wrong theme
    first). Nonce keeps it CSP-compliant.

    It reads ONE input — the data attribute — and resolves it exactly as
    theme_controller.js#applyTheme does. It used to fall back to the `theme`
    cookie when the attribute said "system", which never fired: the attribute is
    `current_user_theme`, which reads that cookie first (#624). A fork that
    changes where `current_user_theme` looks changes this script's input too,
    and nothing here needs to know about it. -%>
<script nonce="<%= content_security_policy_nonce %>">
  (function() {
    var preference = document.documentElement.dataset.themeThemeValue || 'system';
    var shouldBeDark = preference === 'dark' ||
      (preference === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches);
    if (shouldBeDark) {
      document.documentElement.classList.add('dark');
    }
  })();
</script>
