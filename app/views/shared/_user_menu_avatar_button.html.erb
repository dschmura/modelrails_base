<%# locals: (user:) -%>
<%# The label names only who this is; unread counts are announced by the menu's Notifications row.
    It leads with the initials the avatar shows, so speech users can say what they see (WCAG 2.5.3). %>
<% summary ||= unread_notification_summary(user) %>
<button data-menu-target="trigger"
        data-action="click->menu#toggle keydown->menu#triggerKeydown"
        id="user-menu-button"
        aria-haspopup="menu"
        aria-expanded="false"
        aria-controls="user-menu"
        aria-label="<%= t("navigation.user_menu_label_simple", initials: user.identity.initials, name: user.full_name) %>"
        class="btn-touch-target gap-1 rounded-full
               text-on-chrome
               focus-ring-chrome
               cursor-pointer">
  <%= render "shared/user_avatar_header", user: user, summary: summary %>
  <%= icon(:chevron_down, size: :sm,
        data: { test: "user-menu-chevron" },
        class: "text-on-chrome-muted") %>
</button>
