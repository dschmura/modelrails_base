<%# locals: (current_workspace:) -%>
<%# Chrome-free workspace-sidebar contents — workspace nav items.
    Rendered inside `_workspace_sidebar` (which adds the <aside> landmark
    + sidebar visual chrome for the desktop column). Below md, the same
    item source renders as an in-page section-nav strip instead (see
    _section_nav_strip) — not inside this partial.
    The workspace switcher now lives exclusively in the header
    (#workspace-switcher-button, Phase 2b) — not in the sidebar.
    Items come from WorkspaceHelper#workspace_shell_nav_items — single
    source of truth, shared with the mobile strip. -%>
<% section_label_id = "workspace-sidebar-section-label" %>

<%# Section label is a styled <div>, not a heading, associated with the <ul>
    via aria-labelledby — screen readers announce "Workspace, list, N items"
    on entry.

    mb-6 is measured, not chosen: it puts the first nav item's top edge on the
    bottom of the identity-bar logo across the column. mb-2 left it 16px high. %>
<div id="<%= section_label_id %>"
     class="px-3 mb-6 text-xs font-semibold uppercase tracking-wider text-text-muted">
  <%= t("workspaces.sidebar.section_label") %>
</div>

<ul role="list"
    aria-labelledby="<%= section_label_id %>"
    class="flex flex-col gap-1">
  <% workspace_shell_nav_items.each do |item| %>
    <%= render "shared/settings_sidebar_item", **item %>
  <% end %>
</ul>
