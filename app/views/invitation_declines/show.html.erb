<% content_for(:title) { t("invitation_declines.show.title") } %>
<div class="max-w-md mx-auto px-4 py-16 text-center">
  <h1 class="text-3xl font-bold text-text-heading">
    <%= t("invitation_declines.show.title") %>
  </h1>

  <p class="mt-4 text-text-muted">
    <% if @invitation.client_invite? %>
      <%= t("invitation_declines.show.client_body",
            inviter: @invitation.invited_by.email_address,
            project: @invitation.invitable.name) %>
    <% else %>
      <%= t("invitation_declines.show.body",
            workspace: @invitation.invitable.name,
            inviter: @invitation.invited_by.email_address) %>
    <% end %>
  </p>

  <%= button_to t("invitation_declines.show.confirm"),
        decline_invitation_path(token: @invitation.token),
        method: :post,
        class: "btn-outline-danger mt-8 w-full" %>

  <% if @invitation.has_invitee? %>
    <%# Sibling form to the button_to above — the dialog's confirm button_to
        renders its OWN form; never nest them. %>
    <div data-controller="modal" class="mt-4">
      <button type="button"
              class="btn-touch-target btn-text btn-text-danger text-sm focus-ring max-w-full text-center wrap-anywhere"
              data-action="click->modal#open">
        <%= t("invitation_declines.show.block_trigger",
              inviter: @invitation.invited_by.email_address) %>
      </button>
      <%= render "shared/confirm_dialog",
            title: t("invitation_declines.show.block_title",
                     inviter: @invitation.invited_by.email_address),
            message: t("invitation_declines.show.block_message",
                       inviter: @invitation.invited_by.email_address,
                       email: @invitation.email),
            confirm_text: t("invitation_declines.show.block_confirm"),
            confirm_url: block_invitation_path(token: @invitation.token),
            confirm_method: :post,
            variant: :danger %>
    </div>
  <% end %>
</div>
