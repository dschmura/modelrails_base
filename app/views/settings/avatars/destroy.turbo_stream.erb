<%= turbo_stream.replace "user_avatar_profile" do %>
  <%= render "settings/profiles/avatar", user: Current.user %>
<% end %>

<%= turbo_stream.replace "user_avatar_header" do %>
  <%= render "shared/user_avatar_header", user: Current.user, summary: unread_notification_summary(Current.user) %>
<% end %>

<%= turbo_stream.append "modal-body" do %>
  <div data-controller="modal-closer"></div>
<% end %>

<%= turbo_stream.append "toast-pills" do %>
  <%= render "shared/toast_pill", type: :success, message: t("settings.avatars.destroy.success") %>
<% end %>
