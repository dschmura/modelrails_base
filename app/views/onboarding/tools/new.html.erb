<% content_for(:title) { t("onboarding.tools.new.title") } %>
<div class="max-w-md mx-auto px-4 py-16">
  <%= render "onboarding/stepper", current: :team %>

  <h1 class="mt-10 text-3xl font-bold text-text-heading"><%= t("onboarding.tools.new.title") %></h1>
  <p class="mt-2 text-text-body"><%= t("onboarding.tools.new.subtitle") %></p>

  <%= form_with url: onboarding_tools_path, method: :post, class: "mt-8 space-y-4" do |form| %>
    <%# form.checkbox (#737): same builder row as the project-tools edit page
        — 44px target, description as describedby-wired help, no per-box
        hidden field (nil unchecked_value; absent group reads as all-off). %>
    <% @tools.each do |tool| %>
      <div class="rounded-md border border-border p-4">
        <%= form.checkbox :enabled_tools,
              {
                label: tool.name,
                help: tool.description,
                name: "project[enabled_tools][]",
                id: "tool_#{tool.key}",
                checked: @project.tool_enabled?(tool.key)
              },
              tool.key.to_s, nil %>
      </div>
    <% end %>
    <%= form.submit t("onboarding.tools.new.submit"), class: "btn-primary w-full" %>
  <% end %>
</div>
