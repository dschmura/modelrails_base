<%# locals: (membership:, workspace:) %>
<tr id="<%= dom_id(membership) %>"
    class="border-b border-border hover:bg-surface-sunken transition-colors"
    data-controller="focus-return">
  <td class="py-3 px-2 text-text-heading"><%= membership.user.full_name %></td>
  <td class="py-3 px-2 text-text-muted"><%= membership.user.email_address %></td>
  <td class="py-3 px-2 text-text-muted">
    <%= render "role_cell", membership: membership %>
  </td>
  <td class="py-3 px-2">
    <% if membership.discarded? %>
      <%= ui :badge, t("workspaces.members.index.deactivated"), variant: :soft, tone: :danger %>
    <% else %>
      <%= ui :badge, t("workspaces.members.index.active"), variant: :soft, tone: :success %>
    <% end %>
  </td>
  <td class="py-3 px-2">
    <div class="action-group">
    <% if policy(membership).update? %>
      <%= link_to t("workspaces.members.index.edit_role"),
            edit_workspace_member_path(workspace, membership),
            aria: { label: t("workspaces.members.index.edit_role_aria", name: membership.user.full_name) },
            data: {
              turbo_frame: dom_id(membership, :role),
              "focus-return-target": "restoreTo"
            },
            class: "text-sm text-interactive hover:text-interactive-hover
                    inline-flex min-h-input items-center focus-ring rounded" %>
    <% end %>
    <%# These post from inside the members_results frame and redirect with a flash, so each targets `_top` (#1050);
        Deactivate's confirm dialog does it for its own button. %>
    <% if policy(membership).destroy? && !membership.discarded? %>
      <% leaving = membership.user == Current.user %>
      <div data-controller="modal" class="inline">
        <button type="button" data-action="click->modal#open"
                aria-label="<%= t("workspaces.members.index.deactivate_aria", name: membership.user.full_name) %>"
                class="btn-touch-target btn-text btn-text-danger text-sm">
          <%= t("workspaces.members.index.deactivate") %>
        </button>
        <%= render "shared/confirm_dialog",
              id: dom_id(membership, :deactivate),
              title: leaving ? t("workspaces.members.deactivate_dialog.leave_title", workspace_name: workspace.name) :
                               t("workspaces.members.deactivate_dialog.title", name: membership.user.full_name),
              message: leaving ? t("workspaces.members.deactivate_dialog.leave_message", workspace_name: workspace.name) :
                                 t("workspaces.members.deactivate_dialog.message", name: membership.user.full_name, workspace_name: workspace.name),
              confirm_text: leaving ? t("workspaces.members.deactivate_dialog.leave_action") : t("workspaces.members.deactivate_dialog.action"),
              confirm_url: workspace_member_path(workspace, membership) %>
      </div>
    <% end %>
    <% if policy(membership).reactivate? && membership.discarded? %>
      <%= button_to t("workspaces.members.index.reactivate"),
            workspace_member_reactivation_path(workspace, membership),
            method: :post,
            form: { data: { turbo_frame: "_top" } },
            aria: { label: t("workspaces.members.index.reactivate_aria", name: membership.user.full_name) },
            class: "btn-touch-target btn-text btn-text-success text-sm" %>
    <% end %>
    <% if policy(membership).transfer_ownership? %>
      <%= button_to t("workspaces.members.index.transfer_ownership"),
            workspace_member_ownership_transfer_path(workspace, membership),
            method: :post,
            form: { data: { turbo_frame: "_top" } },
            aria: { label: t("workspaces.members.index.transfer_ownership_aria", name: membership.user.full_name) },
            class: "text-sm text-text-muted hover:text-interactive-hover bg-transparent border-0 cursor-pointer
                    inline-flex min-h-input items-center focus-ring rounded" %>
    <% end %>
  </div>
  </td>
</tr>
