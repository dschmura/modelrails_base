<% content_for(:title) { title_with_error_count(t("workspaces.projects.resources.edit.title"), @resource) } %>
<div class="max-w-2xl mx-auto px-4 py-16">
  <h1 class="text-3xl font-bold text-text-heading">
    <%= t("workspaces.projects.resources.edit.title") %>
  </h1>

  <%# dom_id is already globally unique here, so it carries the draft key too.
      `lexxy:change` as in the new form (#479). %>
  <%= form_with model: @resource, url: workspace_project_resource_path(@workspace, @project, @resource), method: :patch,
        id: dom_id(@resource),
        class: "mt-8 space-y-6",
        data: {
          controller: "form-draft",
          action: "input->form-draft#save change->form-draft#save lexxy:change->form-draft#save turbo:submit-end->form-draft#submitEnd"
        } do |form| %>
    <%= render "shared/form_draft_notice" %>

    <%# Same unlinked pair as the new form (#752). %>
    <%= form.error_summary unlinked: [ :resourceable_type, :position ] %>

    <%= form.text_field :title,
          label: t("workspaces.projects.resources.edit.title_label"),
          required: true %>

    <%= form.select :status,
          [
            [ t("workspaces.projects.resources.index.draft"), "draft" ],
            [ t("workspaces.projects.resources.index.published"), "published" ]
          ],
          { label: t("workspaces.projects.resources.edit.status_label") } %>

    <%= render "workspaces/projects/resources/types/#{@resource.resourceable_type.underscore}_form", form: form %>

    <% if @project.clientside_enabled? %>
      <%= form.check_box :shared_with_client,
            label: t("workspaces.projects.resources.edit.share_with_client") %>
    <% end %>

    <%= form.submit t("workspaces.projects.resources.edit.submit"), class: "btn-primary w-full" %>
  <% end %>
</div>
