<% content_for(:title) { t("project_tools.settings.title") } %>
<div class="max-w-2xl mx-auto px-4 py-16">
  <h1 class="text-3xl font-bold text-text-heading"><%= t("project_tools.settings.title") %></h1>
  <p class="mt-2 text-text-body"><%= t("project_tools.settings.subtitle") %></p>

  <%= form_with url: workspace_project_tools_path(@workspace, @project), method: :patch,
        class: "mt-8 space-y-4" do |form| %>
    <%# form.checkbox (#737): one ≥44px label-wrapped target per row (2.5.5 —
        the raw markup had none) with the description as describedby-wired
        help. unchecked_value nil suppresses the per-box hidden field: the
        array param must not collect empty entries, and the controller
        already treats an absent group as all-off. %>
    <% @tools.each do |tool| %>
      <div class="rounded-md border border-border p-4">
        <%= form.checkbox :enabled_tools,
              {
                label: tool.name,
                help: tool.description,
                name: "project[enabled_tools][]",
                id: "tool_#{tool.key}",
                checked: @project.tool_enabled?(tool.key)
              },
              tool.key.to_s, nil %>
      </div>
    <% end %>
    <%= form.submit t("project_tools.settings.save"), class: "btn-primary w-full" %>
  <% end %>
</div>
