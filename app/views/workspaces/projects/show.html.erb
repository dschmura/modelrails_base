<% content_for(:title) { @project.name } %>
<div class="max-w-4xl mx-auto px-4 py-16">
  <% if @project.archived? %>
    <%= render "shared/archived_banner",
          message: t("workspaces.projects.archived_banner"),
          restore_path: unarchive_workspace_project_path(@workspace, @project) %>
  <% end %>
  <%= turbo_stream_from @project %>
  <div class="flex items-center gap-4">
    <%= ui :avatar,
          src: (main_app.url_for(@project.logo) if @project.logo.attached?),
          fallback: @project.initials,
          size: :lg %>
    <div>
      <h1 class="text-3xl font-bold text-text-heading"><%= @project.name %></h1>
      <% if @project.description.present? %>
        <p class="mt-1 text-text-muted"><%= @project.description %></p>
      <% end %>
    </div>
  </div>

  <%= render "workspaces/projects/tool_tabs", project: @project, workspace: @workspace %>

  <nav class="mt-8 flex flex-wrap gap-4" aria-label="<%= t(".nav_label") %>">
    <%= link_to t("workspaces.projects.show.members"), workspace_project_memberships_path(@workspace, @project),
          class: "min-h-[var(--form-input-height)] flex items-center px-4 py-2 rounded-md border border-border
                  text-text-body hover:border-interactive
                  focus-ring" %>
    <% if policy(@project).update? %>
      <%= link_to t("workspaces.projects.show.edit"), edit_workspace_project_path(@workspace, @project),
            class: "min-h-[var(--form-input-height)] flex items-center px-4 py-2 rounded-md border border-border
                    text-text-body hover:border-interactive
                    focus-ring" %>
      <%= link_to t("project_tools.settings.link"), edit_workspace_project_tools_path(@workspace, @project),
            class: "min-h-[var(--form-input-height)] flex items-center px-4 py-2 rounded-md border border-border
                    text-text-body hover:border-interactive focus-ring" %>
      <%= link_to t("clientside.settings.link"), edit_workspace_project_clientside_path(@workspace, @project),
            class: "min-h-[var(--form-input-height)] flex items-center px-4 py-2 rounded-md border border-border
                    text-text-body hover:border-interactive focus-ring" %>
    <% end %>
  </nav>

  <%= render "shared/activity_feed", activities: @activities %>
</div>
