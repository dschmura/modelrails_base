<%# locals: (workspace:) -%>
<tr class="border-t border-border">
  <td class="px-4 py-3 font-medium text-text-heading"><%= workspace.name %></td>
  <td class="px-4 py-3"><%= lifecycle_status_label(workspace) %></td>
  <td class="px-4 py-3 text-text-body"><%= workspace.owners.map(&:full_name).join(", ") %></td>
  <td class="px-4 py-3 text-text-body"><%= workspace.memberships.select(&:kept?).size %></td>
</tr>
