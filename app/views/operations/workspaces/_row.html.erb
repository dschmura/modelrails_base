<%# locals: (workspace:) -%>
<tr class="border-t border-border h-12 align-middle">
  <td class="px-4 py-0 align-middle font-medium">
    <%= link_to workspace.name, operations_workspace_path(workspace), class: "btn-text btn-text-interactive" %>
  </td>
  <td class="px-4 py-0 align-middle"><%= lifecycle_status_label(workspace) %></td>
  <%# Workspace#owner (singular) consumes the controller's memberships
      preload when loaded; #owners (plural) is always a fresh query and
      would N+1 this list. See /docs/developer/architecture (Owner Lookup). %>
  <td class="px-4 py-0 align-middle text-text-body"><%= workspace.owner&.full_name %></td>
  <td class="px-4 py-0 align-middle text-text-body"><%= workspace.memberships.select(&:kept?).size %></td>
</tr>
