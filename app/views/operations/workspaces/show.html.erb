<% content_for(:title) { @workspace.name } %>
<%# shared/settings_page_header has no slot for inline content beside the
    title, so the lifecycle signal — the design system's badge treatment,
    not prose — needs a small bespoke header; same type scale as the shared
    partial (fix round 1, finding 6). %>
<header class="mb-8">
  <div class="flex items-center gap-3">
    <h1 class="text-2xl font-semibold text-text-heading"><%= @workspace.name %></h1>
    <%= ui :badge, lifecycle_status_label(@workspace), variant: :soft, tone: :neutral %>
  </div>
</header>

<section aria-labelledby="ops-members-heading" class="mt-6">
  <h2 id="ops-members-heading" class="text-lg font-semibold text-text-heading"><%= t("operations.workspaces.show.members") %></h2>
  <% if @memberships.any? %>
    <ul class="mt-3 divide-y divide-border rounded-lg border border-border bg-surface">
      <% @memberships.each do |membership| %>
        <li class="flex items-center justify-between px-4 py-3 text-sm">
          <span class="text-text-heading"><%= membership.user.full_name %></span>
          <%= ui :badge, membership.role.name, variant: :soft, tone: :neutral %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <div class="mt-3">
      <%= render "shared/empty_state", message: t("operations.workspaces.show.no_members") %>
    </div>
  <% end %>
</section>

<%= render "shared/activity_feed", activities: @activities %>
