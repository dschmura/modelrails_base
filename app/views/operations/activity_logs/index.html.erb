<% content_for(:title) { "#{t("operations.activity_logs.index.title")} — #{ledger_summary}" } %>
<%= render "shared/settings_page_header", title: t("operations.activity_logs.index.title") %>

<%= render "operations/activity_logs/filters" %>

<%# The live region: present and EMPTY from first render, outside the frame
    so a swap never replaces it; the frame response streams the summary into
    it (see _results). %>
<p id="activity_results_status" class="sr-only" role="status" aria-live="polite" aria-atomic="true"></p>

<%# data-turbo-action=advance on the frame: every link inside it (sort, rows,
    pages, pivots) updates the URL, so a filtered screen is shareable. %>
<%= turbo_frame_tag "activity_results", data: { turbo_action: "advance" } do %>
  <%= render "operations/activity_logs/results" %>
<% end %>

<p class="mt-3 text-xs text-text-muted">
  <%= t("operations.activity_logs.index.footnote", zone: @zone.name) %>
</p>
