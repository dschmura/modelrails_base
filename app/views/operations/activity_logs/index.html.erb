<%# app/views/operations/activity_logs/index.html.erb %>
<% content_for(:title) { t("operations.activity_logs.index.title") } %>
<%= render "shared/settings_page_header",
      title: t("operations.activity_logs.index.title"),
      description: t("operations.activity_logs.index.description") %>

<% if @activities.any? %>
  <div class="mt-4 rounded-lg border border-border bg-surface p-4">
    <ol class="space-y-3">
      <% @activities.each do |activity_log| %>
        <li class="text-sm">
          <span class="text-text-heading font-medium">
            <%= activity_log.workspace ? link_to(activity_log.workspace.name, operations_workspace_path(activity_log.workspace), class: "btn-text focus-ring") : t("operations.activity_logs.index.instance") %>
          </span>
          <ol><%= render partial: "activity_logs/activity_log", locals: { activity_log: activity_log } %></ol>
        </li>
      <% end %>
    </ol>
  </div>
  <%= render "shared/pagination", pagy: @pagy %>
<% else %>
  <%= render "shared/empty_state", message: t("activity.empty") %>
<% end %>
